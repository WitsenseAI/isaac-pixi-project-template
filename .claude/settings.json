{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Bash(git commit *)",
      "Bash(git -C * commit *)",
      "Bash(git push *)",
      "Bash(git -C * push *)",
      "Bash(gh pr create *)",
      "PowerShell(git commit *)",
      "PowerShell(git -C * commit *)",
      "PowerShell(git push *)",
      "PowerShell(git -C * push *)",
      "PowerShell(gh pr create *)"
    ]
  }
}
